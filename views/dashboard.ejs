<!DOCTYPE html>
<html>

<head>
    <title>Scouting</title>
    <link rel="stylesheet" href="/style.css">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>

<body>
    <div class="header">
        <a href="/" class="logo-link">
            <img src="/logo.png" alt="Logo" class="logo">
        </a>
        <h2>Metal Jackets Scouting</h2>
    </div>

    <h2>Welcome <%= username %></h2>
    <h3>Your Assigned Matches & Teams:</h3>

    <div class="cards-container">
        <% matches.forEach(item => { %>
            <div class="card">
                <div class="card-info">
                    <span>Match <%= item.match %></span>
                    <span>Team <%= item.team %></span>
                </div>
                <form action="/scout" method="POST">
                    <input type="hidden" name="eventKey" value="<%= eventKey %>">
                    <input type="hidden" name="username" value="<%= username %>">
                    <input type="hidden" name="matchNumber" value="<%= item.match %>">
                    <input type="hidden" name="teamNumber" value="<%= item.team %>">
                    <button type="submit" class="card-button">Scout</button>
                </form>
            </div>
        <% }) %>
    </div>

</body>
</html>