<!DOCTYPE html>
<html>

<head>
    <title>Scouting Match <%= matchNumber %>
    </title>
    <link rel="stylesheet" href="/style.css">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>

<body>

    <div class="header">
        <a href="/" class="logo-link">
            <img src="/logo.png" alt="Logo" class="logo">
        </a>
        <h2>Match #<%= matchNumber %> — Team <%= teamNumber %>
        </h2>
    </div>

    <form action="/submit-scout" method="POST">
        <input type="hidden" name="eventKey" value="<%= eventKey %>">
        <input type="hidden" name="username" value="<%= username %>">
        <input type="hidden" name="matchNumber" value="<%= matchNumber %>">
        <input type="hidden" name="teamNumber" value="<%= teamNumber %>">

        <label>1. How good is their auto routine?</label>
        <div class="radio-group">
            <label class="radio-option">
                <input type="radio" name="autoRoutine" value="Doesn't score/move" required>
                Doesn't score/move
            </label>
            <label class="radio-option">
                <input type="radio" name="autoRoutine" value="Moves then shoots">
                Moves then shoots
            </label>
            <label class="radio-option">
                <input type="radio" name="autoRoutine" value="Moves then shoots multiple cycles">
                Moves then shoots, multiple cycles
            </label>
        </div>

        <label>2. Did the alliance win auto?</label>
        <div class="radio-group">
            <label class="radio-option">
                <input type="radio" name="autoWin" value="Yes" required>
                Yes
            </label>
            <label class="radio-option">
                <input type="radio" name="autoWin" value="No">
                No
            </label>
        </div>

        <label>3. How big is their hopper?</label>
        <input type="text" name="hopperSize" , placeholder="Type here...">

        <label>4. Actions performed:</label>
        <button type="button" onclick="increment('score')">
            Score: <span id="scoreVal">0</span>
        </button>
        <input type="hidden" id="score" name="score" value="0">

        <button type="button" onclick="increment('climb')">
            Climb: <span id="climbVal">0</span>
        </button>
        <input type="hidden" id="climb" name="climb" value="0">

        <button type="button" onclick="increment('pass')">
            Pass: <span id="passVal">0</span>
        </button>
        <input type="hidden" id="pass" name="pass" value="0">

        <label>5. Was the team being defensive or offensive?</label>
        <div class="radio-group">
            <label class="radio-option">
                <input type="radio" name="role" value="Offensive" required>
                Offensive
            </label>
            <label class="radio-option">
                <input type="radio" name="role" value="Defensive">
                Defensive
            </label>
        </div>

        <label>6. What kind of shooting mechanism did they have?</label>
        <select name="shootingMechanism" required>
            <option value="">--Select--</option>
            <option value="Turret">Turret</option>
            <option value="Stationary">Stationary</option>
            <option value="Double Shooter">Double Shooter</option>
            <option value="N/A">N/A</option>
        </select>

        <label>7. Can they climb?</label>
        <div class="radio-group">
            <label class="radio-option">
                <input type="radio" name="canClimb" value="Yes" required>
                Yes
            </label>
            <label class="radio-option">
                <input type="radio" name="canClimb" value="No">
                No
            </label>
        </div>

        <button type="submit">Submit Scouting</button>
    </form>

    <script>
        function increment(action) {
            const hidden = document.getElementById(action);
            const display = document.getElementById(action + "Val");
            let val = parseInt(hidden.value);
            val++;
            hidden.value = val;
            display.textContent = val;
        }
    </script>

</body>

</html>